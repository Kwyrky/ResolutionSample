<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <MonoGameVersion>3.8.6.1</MonoGameVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- MonoGame Framework Core & Backends (3.8.6.1) -->
    <PackageVersion Include="MonoGame.Framework.Native" Version="$(MonoGameVersion)" />
    <PackageVersion Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
    <PackageVersion Include="MonoGame.Framework.Content.Pipeline" Version="$(MonoGameVersion)" />
    <PackageVersion Include="MonoGame.Runtime.Linux.Vulkan" Version="$(MonoGameVersion)" />
    <PackageVersion Include="MonoGame.Runtime.Windows.Vulkan" Version="$(MonoGameVersion)" />
    <PackageVersion Include="MonoGame.Runtime.Mac.Vulkan" Version="$(MonoGameVersion)" />

    <!-- Content Pipeline Tools & Sub-Libraries -->
    <PackageVersion Include="MonoGame.Library.FreeType" Version="2.13.2.*" />
    <PackageVersion Include="MonoGame.Library.MojoShader" Version="1.0.0.*" />
    <PackageVersion Include="MonoGame.Tool.Basisu" Version="2.0.2.*" />
    <PackageVersion Include="MonoGame.Tool.Crunch" Version="1.0.4.*" />
    <PackageVersion Include="MonoGame.Tool.Dxc" Version="1.9.2607.*" />
    <PackageVersion Include="MonoGame.Tool.FFmpeg" Version="7.0.0.*" />
    <PackageVersion Include="MonoGame.Tool.FFprobe" Version="7.0.0.*" />
    <PackageVersion Include="AssimpNetter" Version="6.0.5.0" />
    <PackageVersion Include="MonoGame.Library.Assimp" Version="6.0.5.1" />
  </ItemGroup>
</Project>
