<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <MonoGamePlatform>DesktopVK</MonoGamePlatform>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" />
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" />
    <PackageReference Include="MonoGame.Runtime.Mac.Vulkan" />
    <PackageReference Include="MonoGame.Runtime.Linux.Vulkan" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResolutionSample.Core\ResolutionSample.Core.csproj" />
  </ItemGroup>

  <Import Project="..\ResolutionSample.Content\BuildContent.targets" />
</Project>
